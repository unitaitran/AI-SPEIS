# Never commit real secrets. Copy this file to .env for local development.
Jwt__Key=replace-with-a-long-random-secret
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Email__SmtpHost=
Email__SmtpPort=587
Email__Username=
Email__Password=
Email__FromEmail=
Email__FromName=AI-SPEIS
GeminiAI__ApiKey=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_SPEECH_REGION=us

# Technical Interview AI (OpenAI-compatible chat/completions endpoint)
TECHNICAL_INTERVIEW_AI_PROVIDER=external
TECHNICAL_INTERVIEW_AI_MODEL=gemini-3.5-flash
TECHNICAL_INTERVIEW_AI_API_KEY=
TECHNICAL_INTERVIEW_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
TECHNICAL_INTERVIEW_AI_TIMEOUT_SECONDS=30
TECHNICAL_INTERVIEW_AI_MAX_RETRIES=2
TECHNICAL_INTERVIEW_CANDIDATE_POOL_SIZE=20
TECHNICAL_INTERVIEW_MAX_TRANSCRIPT_CHARACTERS=12000
TECHNICAL_INTERVIEW_RUBRIC_VERSION=technical-rubric-v1
TECHNICAL_INTERVIEW_SCORING_POLICY_VERSION=technical-scoring-v1
