# Never commit real secrets. Copy this file to .env for local development.
Jwt__Key=replace-with-a-long-random-secret
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Email__SmtpHost=
Email__SmtpPort=587
Email__Username=
Email__Password=
Email__FromEmail=
Email__FromName=AI-SPEIS
GeminiAI__ApiKey=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_SPEECH_REGION=us

# Technical Interview AI (OpenAI-compatible chat/completions endpoint)
TECHNICAL_INTERVIEW_AI_PROVIDER=external
TECHNICAL_INTERVIEW_AI_MODEL=gemini-3.5-flash
TECHNICAL_INTERVIEW_AI_API_KEY=
TECHNICAL_INTERVIEW_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
TECHNICAL_INTERVIEW_AI_TIMEOUT_SECONDS=30
TECHNICAL_INTERVIEW_AI_MAX_RETRIES=2
TECHNICAL_INTERVIEW_CANDIDATE_POOL_SIZE=20
TECHNICAL_INTERVIEW_MAX_TRANSCRIPT_CHARACTERS=12000
TECHNICAL_INTERVIEW_RUBRIC_VERSION=technical-rubric-v2
TECHNICAL_INTERVIEW_PRACTICE_RUBRIC_VERSION=technical-rubric-v1
TECHNICAL_INTERVIEW_SCORING_POLICY_VERSION=technical-scoring-v2
TECHNICAL_INTERVIEW_QUESTION_PLAN_VERSION=technical-question-plan-v1
TECHNICAL_INTERVIEW_ADAPTIVE_RULE_VERSION=technical-adaptive-v1
TECHNICAL_INTERVIEW_BONUS_CALCULATION_VERSION=technical-follow-up-bonus-v1
TECHNICAL_INTERVIEW_STANDARD_MAIN_QUESTION_COUNT=3
TECHNICAL_INTERVIEW_CLARIFICATION_RECOVERY_FACTOR=0.75
TECHNICAL_INTERVIEW_CLARIFICATION_ENDS_MAIN=true
TECHNICAL_INTERVIEW_RELIABILITY_FOLLOW_UP_ENABLED=true
TECHNICAL_INTERVIEW_RELIABILITY_MINIMUM_COUNT=5
TECHNICAL_INTERVIEW_RELIABILITY_FOLLOW_UP_LIMIT=1

# Parallel Technical Answer processing
TECHNICAL_AI_PARALLEL_PROCESSING_ENABLED=true
TECHNICAL_AI_MAX_PARALLEL_TASKS_PER_SESSION=3
TECHNICAL_AI_GLOBAL_CONCURRENCY_LIMIT=10
TECHNICAL_AI_EVALUATION_TIMEOUT_MS=15000
TECHNICAL_AI_FEEDBACK_TIMEOUT_MS=10000
TECHNICAL_AI_QUESTION_TIMEOUT_MS=12000
TECHNICAL_AI_EVALUATION_MAX_RETRIES=1
TECHNICAL_AI_FEEDBACK_MAX_RETRIES=0
TECHNICAL_AI_QUESTION_MAX_RETRIES=1
